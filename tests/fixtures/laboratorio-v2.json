    "configs": {
      "n1-Cisco": {
        "text": "! Propuesta Cisco para R-1\n! Proyecto WAN___Laboratorio_Corte_2 / Sede_asistencial\n! Revisar plataforma y sustituir los marcadores de secretos.\nenable\nconfigure terminal\nhostname R-1\nno ip domain-lookup\nenable secret <CAMBIAR_EN_PRODUCCION>\nno ip http server\nno ip http secure-server\nservice timestamps log datetime msec\nip access-list standard MGMT-SSH\npermit 10.20.2.192 0.0.0.31\ndeny any\nexit\nip domain-name laboratorio.local\nusername operador privilege 1 secret <CAMBIAR_EN_PRODUCCION>\ncrypto key generate rsa modulus 2048\nip ssh version 2\nip ssh time-out 60\nip ssh authentication-retries 3\nline vty 0 15\nlogin local\ntransport input ssh\nexec-timeout 10 0\naccess-class MGMT-SSH in\nexit\ninterface GigabitEthernet0/1\nip address 10.20.3.33 255.255.255.252\nno shutdown\nexit\ninterface GigabitEthernet0/2\nip address 10.20.3.37 255.255.255.252\nno shutdown\nexit\ninterface GigabitEthernet0/3\nip address 10.20.3.45 255.255.255.252\nno shutdown\nexit\nrouter ospf 1\nrouter-id 10.255.0.2\npassive-interface default\nno passive-interface GigabitEthernet0/1\nnetwork 10.20.3.32 0.0.0.3 area 0\nno passive-interface GigabitEthernet0/2\nnetwork 10.20.3.36 0.0.0.3 area 0\nno passive-interface GigabitEthernet0/3\nnetwork 10.20.3.44 0.0.0.3 area 0\nexit\nend\nwrite memory",
        "revision": 3
